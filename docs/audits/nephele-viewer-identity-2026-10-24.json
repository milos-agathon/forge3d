      "old": "    pub fn identity(&self, version: u64) -> DensityIdentity {\n        let bytes = serde_json::to_vec(self).expect(\"density serialization cannot fail\");\n        DensityIdentity {\n            version,\n            digest: Sha256::digest(bytes).into(),\n        }\n    }",
