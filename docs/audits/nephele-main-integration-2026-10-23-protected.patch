-                .module
-                .global_variables
-                .iter()
-                .find(|(handle, _)| handle.index() == index)
-                .and_then(|(_, global)| global.name.clone()),
-            Root::Argument(_) | Root::Local(_) | Root::Alias(_) => None,
-        }
-    }
