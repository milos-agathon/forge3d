-    fn exec_switch(
-        &mut self,
-        function_ref: FunctionRef,
-        cases: &[naga::SwitchCase],
-        selector: Value,
-        state: Frame,
-    ) -> anyhow::Result<Flow> {
-        let selector_range = match selector {
-            Value::Int { lo, hi } => Some((lo, hi)),
-            _ => None,
-        };
