-            Value::Array { element, length } => {
-                if !length.is_some_and(|length| lo >= 0 && hi < length as i64) {
-                    self.alarm_expr(
-                        function_ref,
-                        handle,
-                        "possible_oob",
-                        "dynamic array index is not proved in bounds",
-                    );
-                }
