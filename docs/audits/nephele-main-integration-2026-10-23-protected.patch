-    fn coalesce(mut states: Vec<Frame>) -> Vec<Frame> {
-        if states.len() <= 1 {
-            return states;
-        }
-        let mut joined = states.remove(0);
-        for state in states {
-            joined.join(&state);
-        }
-        vec![joined]
-    }
