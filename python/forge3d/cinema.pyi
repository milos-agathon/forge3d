from typing import Callable, Sequence, Any
from dataclasses import dataclass
from os import PathLike
from .animation import CameraAnimation
from .terrain_scatter import TerrainScatterSource

class CinemaInfeasible(ValueError):
    diagnostic: dict[str, Any]
    binding_constraint: str
class CinemaNativeUnavailable(RuntimeError): ...
@dataclass(frozen=True)
class Subject:
    bounds: tuple[tuple[float, float, float], tuple[float, float, float]]
    @classmethod
    def point(cls, position: Sequence[float], *, diameter: float) -> Subject: ...
    @classmethod
    def from_lon_lat_height(cls, position: Sequence[float], *, to_world: Callable, diameter: float) -> Subject: ...
    @classmethod
    def from_lon_lat_bounds(cls, bounds: Sequence[Sequence[float]], *, to_world: Callable) -> Subject: ...
@dataclass(frozen=True)
class FramingSpec:
    region: tuple[float, float, float, float]
    size_frac_band: tuple[float, float]
    headroom: float
    fov_deg: float
    aspect: float
@dataclass(frozen=True)
class Shot:
    kind: str
    subject: Subject
    duration_s: float
    framing: FramingSpec
    clearance: float
    max_speed: float
    max_jerk: float
    bearing_deg: tuple[float, float]
    elevation_deg: tuple[float, float]
    transition: tuple[float, float] = ...
    start_eye: tuple[float, float, float] | None = ...
    end_eye: tuple[float, float, float] | None = ...
    max_refine_passes: int = ...
@dataclass(frozen=True)
class ShotPlan:
    shots: tuple[Shot, ...]
    def __init__(self, shots: Sequence[Shot]) -> None: ...
    @property
    def validation(self) -> list[dict[str, Any]]: ...
    @property
    def orbit_adjustments(self) -> list[dict[str, Any] | None]: ...
    @property
    def keyframes_json(self) -> str: ...
    def bake(self) -> CameraAnimation: ...
    def to_json(self) -> str: ...
    @classmethod
    def from_json(cls, text: str) -> ShotPlan: ...
    def validate(self, source: TerrainScatterSource) -> list[dict[str, Any]]: ...
    def link_certificate(self, path: str | PathLike[str], *, pubkey: bytes | str | PathLike[str], frame_time: float) -> ShotPlan: ...
def plan(shots: Sequence[Shot] | ShotPlan, source: TerrainScatterSource) -> ShotPlan: ...
