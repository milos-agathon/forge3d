from typing import Any, Mapping, Sequence
import numpy as np
from .terrain_materials import TerrainMaterialRecipe, TerrainMaterialLayer, MaterialGrid, MaterialTexture
from .map_scene import SceneRecipe, VectorOverlay, BuildingLayer
from .raster_style import RasterStyleResult, CategoricalRasterStyle

MaterialLayer = TerrainMaterialLayer

class MaterialEvaluation:
    rgba: np.ndarray
    masks: dict[str, np.ndarray]
    legend: dict[str, Any] | None
    crs: str
    normals: np.ndarray | None
    roughness: np.ndarray | None

class GeospatialMaterialRecipe(TerrainMaterialRecipe):
    @classmethod
    def land_cover(cls, categorical: CategoricalRasterStyle, *, albedo: Sequence[int], texture: MaterialTexture | None = ..., relief_strength: float = ...) -> GeospatialMaterialRecipe: ...
    @classmethod
    def rock_snow(cls, ground: TerrainMaterialLayer, rock: TerrainMaterialLayer, snow: TerrainMaterialLayer, *, rock_slope_degrees: tuple[float, float], snow_elevation_m: tuple[float, float], snow_slope_degrees: tuple[float, float], presentation: str = ..., categorical: CategoricalRasterStyle | None = ..., relief_strength: float = ..., relief_mode: str = ...) -> GeospatialMaterialRecipe: ...
    def with_layer(self, name: str, **overrides: Any) -> GeospatialMaterialRecipe: ...
    @classmethod
    def from_dict(cls, data: Mapping[str, Any]) -> GeospatialMaterialRecipe: ...
    def evaluate_samples(self, coordinates_m: Any, *, crs: str, units: str, fields: Mapping[str, tuple[Any, str]] | None = ..., classes: Any = ..., normals_enu: Any = ..., footprint_m: tuple[float, float] | None = ...) -> MaterialEvaluation: ...
    def prepare_raster(self, values: Any, grid: MaterialGrid, *, units: str, classes: Any = ..., fields: Mapping[str, tuple[Any, str]] | None = ..., elevations: Any = ..., derivative_halo: Any = ...) -> RasterStyleResult: ...
    def bind_raster(self, scene: SceneRecipe, values: Any, grid: MaterialGrid, *, units: str, classes: Any = ..., fields: Mapping[str, tuple[Any, str]] | None = ..., elevations: Any = ..., derivative_halo: Any = ..., layer_id: str = ...) -> SceneRecipe: ...
    def bind_vector(self, layer: VectorOverlay, coordinates_m: Any, *, units: str, classes: Any = ..., fields: Any = ...) -> VectorOverlay: ...
    def bind_buildings(self, layer: BuildingLayer, coordinates_m: Any, *, units: str, classes: Any = ..., fields: Any = ..., presentation: str = ...) -> BuildingLayer: ...
    def attach(self, scene: SceneRecipe, *layers: Any) -> SceneRecipe: ...

class MaterialRasterStyle:
    recipe: TerrainMaterialRecipe
    grid: MaterialGrid
    classes: Any
    fields: Mapping[str, tuple[Any, str]]
    derivative_halo: Any
    value_units: str
    elevations: Any
    def __init__(self, recipe: TerrainMaterialRecipe, grid: MaterialGrid, classes: Any = ..., fields: Mapping[str, tuple[Any, str]] | None = ..., derivative_halo: Any = ..., value_units: str = ..., elevations: Any = ...) -> None: ...
    def apply(self, source: Any, *, valid_mask: Any = ...) -> RasterStyleResult: ...
    def channels(self, source: Any) -> tuple[np.ndarray | None, np.ndarray | None]: ...
    def validate_scene(self, scene: SceneRecipe) -> None: ...
    def to_dict(self) -> dict[str, Any]: ...
    @classmethod
    def from_dict(cls, data: Mapping[str, Any]) -> MaterialRasterStyle: ...
